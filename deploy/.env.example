# Variable names only. Values stay empty here; set them in your environment or a local .env
# (never commit a .env with values).

# --- The Makna application (makna serve and the operator commands) ---
# Required. Connection URL of the Makna application database (PostgreSQL with pgvector).
MAKNA_DATABASE_URL=
# Required. Secret used to sign sessions and tokens: at least 32 characters, for example the
# output of: openssl rand -hex 32 (64 characters). A shorter value is refused at start.
MAKNA_SECRET_KEY=
# Path of the definitions git repository.
MAKNA_DEFINITIONS_REPO=
# Optional. Read-only URL of the target database, for the freshness check and catalog compare.
MAKNA_ENGINE_URL=
# Embedding provider: fastembed (default), ollama, openai_compatible, or hash (tests only).
MAKNA_EMBEDDING_PROVIDER=
# Optional. Directory of the fastembed model files (the Docker image sets /opt/makna/models).
MAKNA_EMBEDDING_CACHE_DIR=
# Optional. API key for the openai_compatible embedding provider. Never put it in a file.
# Optional. true lets the fastembed provider download its model (outside Docker, once).
MAKNA_EMBEDDING_ALLOW_DOWNLOAD=
MAKNA_EMBEDDING_API_KEY=
# Optional. Bearer token for the OpenMetadata connector.
MAKNA_OPENMETADATA_TOKEN=
# Optional. true lets an author approve their own change; only for single-user installs (D-11).
# Read like every other true/false setting: true, 1, yes, on, y, t (any case) turn the two-person
# rule off; false, 0, no, off, n, f or empty keep it; any other value stops the start.
MAKNA_ALLOW_SELF_APPROVAL=

# Optional. true leaves the Secure flag off the session cookie, for a stack served over plain http://
# (the development stack sets it). Leave it empty or false for a deployment behind https.
MAKNA_WEB_DEVELOPMENT=

# --- The stdio bridge (makna mcp), on the agent's machine; it holds nothing else ---
# Base URL of the Makna application, for example http://localhost:8000. The bridge appends /mcp
# (a trailing /mcp is not doubled). http:// only for localhost, https:// for any other host, and no
# user name or password in it: the token is sent with every request.
MAKNA_URL=
# Makna API token of the agent's user (makna token create). There is no command-line option for
# it, because an option shows in the process list.
MAKNA_TOKEN=

# --- The development stack (deploy/docker-compose.yml) ---
# Passwords of the local PostgreSQL roles. The compose file has development defaults for
# these four only; set them to override. MAKNA_SECRET_KEY above has no default and must be set.
MAKNA_POSTGRES_PASSWORD=
MAKNA_DB_PASSWORD=
MAKNA_LENDING_LOADER_PASSWORD=
MAKNA_LENDING_READER_PASSWORD=
# Host port for PostgreSQL (published on 127.0.0.1 only). Default 5432.
MAKNA_POSTGRES_PORT=
# URL of the `lending` database as the loader role; used by deploy/init.py.
MAKNA_LENDING_LOADER_URL=
# Password of the four demo users that `init` creates (viewer, curator, approver, admin at
# demo.example). At least 12 characters. No default: without it `init` creates no demo users.
MAKNA_DEMO_PASSWORD=

# --- Tests and evals ---
# Optional. Set to 1 (CI does) so that a missing MAKNA_TEST_DATABASE_URL fails the integration
# tier instead of skipping it.
MAKNA_REQUIRE_TEST_DATABASE=
# Optional. URL of the PostgreSQL used by the integration and engine test tiers.
MAKNA_TEST_DATABASE_URL=
# Optional. Google AI Studio key for the agent eval (makna-eval agent, WP-22B).
GEMINI_API_KEY=
