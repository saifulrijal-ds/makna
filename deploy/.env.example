# Variable names only. Values stay empty here; set them in your environment or a local .env
# (never commit a .env with values).

# --- The Makna application (makna serve and the operator commands) ---
# Required. Connection URL of the Makna application database (PostgreSQL with pgvector).
MAKNA_DATABASE_URL=
# Required. Secret used to sign sessions and tokens.
MAKNA_SECRET_KEY=
# Path of the definitions git repository.
MAKNA_DEFINITIONS_REPO=
# Optional. Read-only URL of the target database, for the freshness check and catalog compare.
MAKNA_ENGINE_URL=
# Embedding provider: fastembed (default), ollama, openai_compatible, or hash (tests only).
MAKNA_EMBEDDING_PROVIDER=
# Optional. Bearer token for the OpenMetadata connector.
MAKNA_OPENMETADATA_TOKEN=
# Optional. true lets an author approve their own change; only for single-user installs (D-11).
MAKNA_ALLOW_SELF_APPROVAL=

# --- The stdio bridge (makna mcp), on the agent's machine; it holds nothing else ---
# URL of the Makna application, for example http://localhost:8000.
MAKNA_URL=
# Makna API token of the agent's user.
MAKNA_TOKEN=

# --- The development stack (deploy/docker-compose.yml) ---
# Passwords of the local PostgreSQL roles. The compose file has development defaults for
# these four only; set them to override. MAKNA_SECRET_KEY above has no default and must be set.
MAKNA_POSTGRES_PASSWORD=
MAKNA_DB_PASSWORD=
MAKNA_LENDING_LOADER_PASSWORD=
MAKNA_LENDING_READER_PASSWORD=
# Host port for PostgreSQL (published on 127.0.0.1 only). Default 5432.
MAKNA_POSTGRES_PORT=
# URL of the `lending` database as the loader role; used by deploy/init.py.
MAKNA_LENDING_LOADER_URL=

# --- Tests and evals ---
# Optional. Set to 1 (CI does) so that a missing MAKNA_TEST_DATABASE_URL fails the integration
# tier instead of skipping it.
MAKNA_REQUIRE_TEST_DATABASE=
# Optional. URL of the PostgreSQL used by the integration and engine test tiers.
MAKNA_TEST_DATABASE_URL=
# Optional. Google AI Studio key for the agent eval (makna-eval agent, WP-22B).
GEMINI_API_KEY=
